{
  "manifest_version": 3,
  "name": "SocialLens",
  "version": "0.1.0",
  "description": "Local social media data gateway. Captures and executes requests inside your own logged-in tabs.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "https://*.bilibili.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.douyin.com/*",
    "https://mp.weixin.qq.com/*",
    "https://*.kuaishou.com/*",
    "https://channels.weixin.qq.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://*.reddit.com/*",
    "https://*.zhihu.com/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://*.linkedin.com/*",
    "https://*.toutiao.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.douyin.com/*",
        "https://mp.weixin.qq.com/*",
        "https://*.kuaishou.com/*",
        "https://channels.weixin.qq.com/*",
        "https://*.youtube.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://*.reddit.com/*",
        "https://*.zhihu.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.linkedin.com/*",
        "https://*.toutiao.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.douyin.com/*",
        "https://mp.weixin.qq.com/*",
        "https://*.kuaishou.com/*",
        "https://channels.weixin.qq.com/*",
        "https://*.youtube.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://*.reddit.com/*",
        "https://*.zhihu.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.linkedin.com/*",
        "https://*.toutiao.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SocialLens"
  }
}
